// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// Core Entities
// ----------------------------------------------------------------------------

model User {
  id           String         @id @default(uuid())
  nome         String
  email        String         @unique
  senha_hash   String
  papel_global String         @default("COLABORADOR") // ADMIN, LIDER, REVISOR, COLABORADOR
  criado_em    DateTime       @default(now())

  missoes      Missao[]
  entregas     Entrega[]
  revisoes     Revisao[]
  documentos   Documento[]
  permissoes   Permissao[]
  logs         LogAuditoria[]
}

model Workspace {
  id          String      @id @default(uuid())
  nome        String
  descricao   String?
  areas       Area[]
  permissoes  Permissao[]
}

model Area {
  id           String      @id @default(uuid())
  workspace_id String
  nome         String
  tipo         String      // ex: PERICIA, MARKETING, CURSOS

  workspace    Workspace   @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  projetos     Projeto[]
  tipos_proj   TipoProjeto[]
}

model Projeto {
  id           String      @id @default(uuid())
  area_id      String
  nome         String
  descricao    String?
  status       String      @default("ATIVO") // ATIVO, ARQUIVADO, CONCLUIDO
  prazo        DateTime?

  area         Area        @relation(fields: [area_id], references: [id], onDelete: Cascade)
  missoes      Missao[]
  documentos   Documento[]
  arquivos     Arquivo[]
  permissoes   Permissao[]
  valores_campo ValorCampo[]
}

model Missao {
  id              String      @id @default(uuid())
  projeto_id      String
  titulo          String
  descricao       String?
  responsavel_id  String?
  status          String      @default("PENDENTE") // PENDENTE, EM_ANDAMENTO, EM_REVISAO, APROVADA, REJEITADA
  prazo           DateTime?
  criterio_aceite String?
  valor_bounty    Float?

  projeto         Projeto     @relation(fields: [projeto_id], references: [id], onDelete: Cascade)
  responsavel     User?       @relation(fields: [responsavel_id], references: [id], onDelete: SetNull)
  entregas        Entrega[]
  valores_campo   ValorCampo[]
}

// ----------------------------------------------------------------------------
// Execution & Content Entities
// ----------------------------------------------------------------------------

model Documento {
  id          String      @id @default(uuid())
  projeto_id  String
  autor_id    String
  tipo        String      @default("MARKDOWN")
  conteudo    String      @db.Text
  tags        String[]
  criado_em   DateTime    @default(now())
  atualizado_em DateTime  @updatedAt

  projeto     Projeto     @relation(fields: [projeto_id], references: [id], onDelete: Cascade)
  autor       User        @relation(fields: [autor_id], references: [id])
}

model Arquivo {
  id          String      @id @default(uuid())
  projeto_id  String
  nome        String
  caminho     String
  hash_sha256 String
  tamanho     Int
  tipo_mime   String
  enviado_por String
  enviado_em  DateTime    @default(now())

  projeto     Projeto     @relation(fields: [projeto_id], references: [id], onDelete: Cascade)
  entrega_id  String?
  entrega     Entrega?    @relation(fields: [entrega_id], references: [id], onDelete: SetNull)
}

model Entrega {
  id          String      @id @default(uuid())
  missao_id   String
  autor_id    String
  conteudo    String?     @db.Text
  status      String      @default("EM_REVISAO") // EM_REVISAO, APROVADA, REJEITADA
  criado_em   DateTime    @default(now())

  missao      Missao      @relation(fields: [missao_id], references: [id], onDelete: Cascade)
  autor       User        @relation(fields: [autor_id], references: [id])
  revisoes    Revisao[]
  arquivos    Arquivo[]
}

model Revisao {
  id          String      @id @default(uuid())
  entrega_id  String
  revisor_id  String
  status      String      // APROVADO, REJEITADO
  comentario  String?     @db.Text
  criado_em   DateTime    @default(now())

  entrega     Entrega     @relation(fields: [entrega_id], references: [id], onDelete: Cascade)
  revisor     User        @relation(fields: [revisor_id], references: [id])
}

// ----------------------------------------------------------------------------
// System Integrity Entities
// ----------------------------------------------------------------------------

model Permissao {
  id           String      @id @default(uuid())
  user_id      String
  papel        String
  workspace_id String?
  projeto_id   String?

  user         User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  workspace    Workspace?  @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  projeto      Projeto?    @relation(fields: [projeto_id], references: [id], onDelete: Cascade)
}

model LogAuditoria {
  id               String   @id @default(uuid())
  user_id          String?
  acao             String
  entidade         String
  entidade_id      String
  timestamp        DateTime @default(now())
  dados_anteriores Json?
  dados_novos      Json?

  user             User?    @relation(fields: [user_id], references: [id], onDelete: SetNull)
}

// ----------------------------------------------------------------------------
// Customization Entities
// ----------------------------------------------------------------------------

model TipoProjeto {
  id                 String              @id @default(uuid())
  area_id            String
  nome               String

  area               Area                @relation(fields: [area_id], references: [id], onDelete: Cascade)
  tipos_missao       TipoMissao[]
  campos_customizados CampoCustomizado[]
}

model TipoMissao {
  id                 String              @id @default(uuid())
  tipo_projeto_id    String
  nome               String

  tipo_projeto       TipoProjeto         @relation(fields: [tipo_projeto_id], references: [id], onDelete: Cascade)
  campos_customizados CampoCustomizado[]
}

model CampoCustomizado {
  id               String      @id @default(uuid())
  nome_campo       String
  tipo_dado        String      // TEXTO, NUMERO, DATA, SELECAO
  obrigatorio      Boolean     @default(false)
  tipo_projeto_id  String?
  tipo_missao_id   String?

  tipo_projeto     TipoProjeto? @relation(fields: [tipo_projeto_id], references: [id], onDelete: Cascade)
  tipo_missao      TipoMissao?  @relation(fields: [tipo_missao_id], references: [id], onDelete: Cascade)
  valores          ValorCampo[]
}

model ValorCampo {
  id               String      @id @default(uuid())
  entidade_tipo    String      // PROJETO ou MISSAO
  projeto_id       String?
  missao_id        String?
  campo_id         String
  valor            String      @db.Text

  campo            CampoCustomizado @relation(fields: [campo_id], references: [id], onDelete: Cascade)
  projeto          Projeto?         @relation(fields: [projeto_id], references: [id], onDelete: Cascade)
  missao           Missao?          @relation(fields: [missao_id], references: [id], onDelete: Cascade)
}
